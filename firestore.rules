// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()      { return request.auth != null; }
    function isWhitelisted() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function myCRE() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cre;
    }
    function isAdmin() { return isWhitelisted() && role() == 'admin'; }

    match /users/{userId} {
      allow get: if isAuth() && request.auth.uid == userId;
      allow list, read: if isWhitelisted();
      allow create, update, delete: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read:  if isWhitelisted();
      allow write: if isWhitelisted() && role() in ['admin','supervisor', 'analyst'];
    }

    match /analyses/{analysisId} {
      allow read:   if isWhitelisted();
      allow create: if isWhitelisted();
      allow update: if isWhitelisted();
      allow delete: if isAdmin();

      match /elementResults/{elementId} {
        allow read:  if isWhitelisted();
        allow write: if isWhitelisted();
      }

      match /observations/{obsId} {
        allow read:  if isWhitelisted();
        allow write: if isWhitelisted();
      }
    }

    match /checklist_definitions/{elementId} {
      allow read:  if isWhitelisted();
      allow write: if isAdmin();
    }

    match /schoolVisits/{visitId} {
      allow read:  if isWhitelisted();
      allow write: if isWhitelisted();

      match /{subpath=**} {
        allow read, write: if isWhitelisted();
      }
    }

    // ─── Feira de Ciências ─────────────────────────────────────────────

    match /feira_edicoes/{docId} {
      allow read: if true;
      allow write: if isWhitelisted() && role() in ['admin','analyst'];
    }

    match /feira_links_escolas/{token} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feira_rascunhos/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /feira_inscricoes/{docId} {
      allow read: if isWhitelisted()
        || (isAuth() && request.auth.uid in resource.data.avaliadores);
      allow create: if false;
      allow update: if isWhitelisted();
    }

    match /feira_avaliacoes/{docId} {
      allow read: if isWhitelisted()
        || (isAuth() && request.auth.uid == resource.data.avaliador_uid);
      allow create, update: if isAuth()
        && request.auth.uid == request.resource.data.avaliador_uid;
    }

    match /feira_recursos/{docId} {
      allow create: if isAuth();
      allow read, update: if isWhitelisted() && role() in ['supervisor','admin'];
    }

    match /audit_log/{logId} {
      allow read:   if isWhitelisted() && role() in ['supervisor','admin'];
      allow create: if isWhitelisted();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
